# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/
.superpowers/

# git worktrees
.worktrees/

# graphify — commit graph.json + GRAPH_REPORT.md; ignore cache
graphify-out/cache/
graphify-out/.graphify_*
graphify-out/manifest.json

# personal Obsidian vault at repo root (not project code)
/1o8Hub/

# Excel temp lockfiles (created by Office while a workbook is open)
~$*

# Per-client onboarding source data — kept local, never committed
docs/MIS_*
docs/*_CLR.xlsm
docs/*_ALR.txt

# Claude Code runtime locks
.claude/scheduled_tasks.lock

# Claudify bundle source + pre-integration backups (kept local)
/bundle/
/.claude.pre-bundle.bak/
/CLAUDE.md.pre-bundle.bak

# Claudify bundle working files (per-user, not committed)
.claude/CLAUDE.local.md
.claude/daily/
.claude/task-board.md
.claude/scratchpad.md
.claude/clients/
# Bundle's default root-level paths if any tool auto-creates them
/Daily Notes/
/Task Board.md
/Scratchpad.md

# Auto-generated by hooks (per-environment, no value in version history)
.claude/backups/
.claude/logs/incident-log.md

# Other local AI/dev tool dirs + caches (per-user, not committed)
.agents/
.backups/
.kiro/
.junie/
.claude/council-cache/
.claude/skills/react-doctor/

# 1o8 local-only: embedded Postgres data (contains real team/client data) and scratch files
/.data/
q.tmp.*
/docs/master-table.xlsx
/seo-manager-reference/
/.cursor/Dockerfile
/newsletter/
/.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/1o8-seo-manager/
