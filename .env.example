# Database (Supabase / Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host:6543/dbname?sslmode=require"

# NextAuth.js
NEXTAUTH_URL="https://1o8hub.vercel.app"
NEXTAUTH_SECRET=""  # Generate with: openssl rand -base64 32

# Google OAuth (console.cloud.google.com -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Cloud / BigQuery
GCP_PROJECT_ID="amazon-data-461918"
GCP_CLIENT_EMAIL="seo-manager@amazon-data-461918.iam.gserviceaccount.com"
GCP_PRIVATE_KEY=""  # MUST set via Vercel CLI, not dashboard: npx vercel env add GCP_PRIVATE_KEY production < /path/to/key.pem
BQ_DATASET="1o8Hub"
BQ_TABLE="Master"

# Non-core BigQuery datasets (sub-project #1b).
# Default to the legacy 1o8 project so behavior is unchanged until set.
# On the MFHub deploy (mfhub-501815) set the right-hand values; the CONFIRM
# ones require probing mfhub-501815 first (dataset/table names + region).
BQ_BIBLEAPP_PROJECT_ID="amazon-data-461918"   # MFHub: mfhub-501815
BQ_BIBLEAPP_DATASET="1o8BibleApp"             # MFHub: MFBibleApp
BQ_BIBLEAPP_LOCATION="us-west1"               # MFHub: CONFIRM region of copy
BQ_SEO_PROJECT_ID="amazon-data-461918"        # MFHub: mfhub-501815
BQ_SEO_DATASET="1o8MSEO"                      # MFHub: MFMSEO
BQ_SEO_OUTPAPLUS_TABLE="OUT_PA+"              # MFHub: CONFIRM (OUT_PA+ or renamed)
BQ_MAAC_PROJECT_ID="amazon-data-461918"       # MFHub: mfhub-501815
BQ_MAAC_DATASET="1o8MAAC"                     # MFHub: MFMAAC
BQ_MAAC_TABLE="1o8MAAC_AAC"                   # MFHub: CONFIRM (1o8MAAC_AAC or MFMAAC_AAC)

# Google Drive
GOOGLE_SHARED_DRIVE_ID=""
GOOGLE_DRIVE_FOLDER_ID=""

# File ID of the master attribute-template spreadsheet (has the onEdit Apps
# Script container-bound). Template-requests copies this file instead of
# creating from scratch so the bound script is preserved.
# Setup steps: see src/lib/template-apps-script.ts header comment.
ATTRIBUTE_TEMPLATE_MASTER_ID=""

# AI (Anthropic)
ANTHROPIC_API_KEY=""

# Amazon Sync
RAINFOREST_API_KEY=""
# Reviews weekly snapshot cron (every 5 min on Saturdays UTC until every active ASIN is
# fresh): ASINs per call (1-100, default 20), refresh ASINs older than N days (default 6),
# set "false" to pause the cron.
REVIEWS_SYNC_BATCH=""
REVIEWS_SYNC_STALE_DAYS=""
REVIEWS_SYNC_ENABLED=""
FIRECRAWL_API_KEY=""

# Helium 10 MCP (S2 reverse-ASIN keywords + review topics/history). API key from
# Helium 10 → Settings → MCP, sent as a Bearer token to https://mcp.helium10.com/mcp.
# When set it replaces the shared OAuth connection (HELIUM10_CONNECTION_OWNER_ID);
# when unset the OAuth connection is used. Every tool call costs 1 of the account's
# monthly MCP calls (1,000/month on Diamond) — each call is logged as "[helium10] tool call".
HELIUM10_API_KEY=""
# Master switch for every Helium 10 connection. OFF unless exactly "true": S2 keywords use the
# Cerebro CSV upload, S3 reviews use the review CSV upload, review syncs skip Helium 10.
NEXT_PUBLIC_HELIUM10_ENABLED=""

# Amazon SP-API (LWA app credentials -- shared across all clients)
SP_API_CLIENT_ID=""
SP_API_CLIENT_SECRET=""

# Vercel Cron secret (used to authenticate cron job requests)
CRON_SECRET=""  # Generate with: openssl rand -base64 32

# Payment PII (Wise ID, tax ID, Wise QR) — AES-256-GCM. Required for /team payment save.
# Generate: openssl rand -base64 32   (must decode to exactly 32 bytes)
# Also set in Vercel: npx vercel env add USER_PII_ENCRYPTION_KEY production
USER_PII_ENCRYPTION_KEY=""

# Email (Resend) — sending domain marketfoundry.agency
RESEND_API_KEY=""
RESEND_FROM_EMAIL="MarketFoundry <reports@marketfoundry.agency>"

# Amazon Redshift (Intentwise analytics)
REDSHIFT_HOST=""
REDSHIFT_PORT="5439"
REDSHIFT_DATABASE="data_platform"
REDSHIFT_USER=""
REDSHIFT_PASSWORD=""

# Monthly report PDF rendering
# Secret used to sign short-lived JWTs that carry the report payload into
# the internal print route. Required on every environment.
MONTHLY_REPORT_JWT_SECRET=change-me

# Monthly report ↔ Asana link (creates + ticks the period's review task). Off unless exactly "true";
# periods before 2026-10 are never written either way.
# MONTHLY_REPORT_ASANA_ENABLED="true"
# Sandbox only: prefixes every created Asana task/subtask name, e.g. "[TEST] ". Leave unset in production.
# MONTHLY_REPORT_ASANA_TEST_PREFIX="[TEST] "

# Local dev only: macOS full Chrome path (skip @sparticuz/chromium locally).
# /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
PUPPETEER_EXECUTABLE_PATH=

# Shared team logins vault (/admin/logins) — AES-256-GCM.
# Optional. If unset, the key is derived from NEXTAUTH_SECRET (same pattern as Helium 10).
# Generate: openssl rand -base64 32
# SHARED_LOGINS_ENCRYPTION_KEY=""

# Asana task mirror (/api/cron/asana-tasks-sync, every 15 min; locally: npm run sync:asana).
# 1o8 Agency values: "AAA - 1o8 Agency Reporting" project + "1O8 Status" / "1O8 Priority" fields.
ASANA_ACCESS_TOKEN=""
ASANA_REPORTING_PROJECT_GID="1213231671264464"
ASANA_STATUS_FIELD_GID="1210746742899759"
ASANA_PRIORITY_FIELD_GID="1213197114817830"

# ── Time off: shared Google Calendar + Gusto (Sync & Export → Time Off) ──
# Calendar id of "1o8 Time off (PTO/OOO/Sick)"; share the calendar with the
# service account (GOOGLE_SERVICE_ACCOUNT_JSON) with "Make changes to events".
# Leave unset locally so dev never writes the real calendar.
TIME_OFF_CALENDAR_ID=""
TIME_OFF_CALENDAR_TZ="America/Chicago"
# Gusto developer app (read time off, balances, employees). Redirect URL:
# https://<hub>/api/integrations/gusto/callback
GUSTO_CLIENT_ID=""
GUSTO_CLIENT_SECRET=""
GUSTO_API_BASE="https://api.gusto.com"
GUSTO_API_VERSION=""
GUSTO_COMPANY_UUID=""
NEXT_PUBLIC_GUSTO_TIME_OFF_URL="https://app.gusto.com"
