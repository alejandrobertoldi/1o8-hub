{
  "crons": [
    {
      "path": "/api/cron/readiness-snapshot",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/aac-sync",
      "schedule": "0 11 * * *"
    }
  ],
  "functions": {
    "src/app/api/reports/monthly/route.ts": {
      "memory": 2048,
      "maxDuration": 300
    },
    "src/app/api/reports/monthly/pdf/route.ts": {
      "memory": 2048,
      "maxDuration": 60
    },
    "src/app/api/reports/monthly/pdf/drive/route.ts": {
      "memory": 2048,
      "maxDuration": 60
    },
    "src/app/api/cron/monthly-reports/route.ts": {
      "memory": 2048,
      "maxDuration": 300
    },
    "src/app/api/cron/reviews-sync/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/reviews/sync/route.ts": {
      "maxDuration": 300
    }
  }
}
